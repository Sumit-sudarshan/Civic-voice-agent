# --- LLM backend switch ---
# Reasoning: GROQ_API_KEY set -> Groq. Else OPENROUTER_API_KEY set -> OpenRouter.
# Else -> Ollama (OLLAMA_LLM_MODEL).
# Embeddings are ALWAYS local Ollama (EMBEDDING_MODEL) — PII-bearing complaint
# text never leaves the VM, regardless of reasoning backend. See MVP_Design.md §3.1.

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OLLAMA_LLM_MODEL=qwen2.5:1.5b

EMBEDDING_MODEL=nomic-embed-text

# Needed once, for Hindi/Marathi translation (gated model on Hugging Face).
# See backend/app/pipeline/translation.py for the one-time setup steps.
HF_TOKEN=

# --- Supabase ---
# New-style Supabase API keys: PUBLISHABLE_KEY is the anon-key equivalent
# (safe for client use), SECRET_KEY is the service-role equivalent (bypasses
# RLS — server-side only, never sent to the frontend).
PUBLISHABLE_KEY=
SECRET_KEY=
SUPABASE_URL=https://<ref>.supabase.co
# Supavisor transaction-mode pooler URL (port 6543) — required, not the
# direct :5432 connection. Used in every environment, dev included, so there
# is no separate local database to run.
DATABASE_URL=postgresql+psycopg2://postgres.<ref>:<url-encoded-pw>@<host>.pooler.supabase.com:6543/postgres

OLLAMA_HOST=http://localhost:11434
OLLAMA_NUM_THREAD=4
