# --- LLM backend switch ---
# Reasoning: OPENROUTER_API_KEY set -> OpenRouter (primary). GROQ_API_KEY set
# -> Groq (failover). At least one MUST be set, or the app fails to start —
# Ollama is NOT a reasoning fallback (embeddings only, see below).
# Embeddings are ALWAYS local Ollama (EMBEDDING_MODEL) — PII-bearing complaint
# text never leaves the VM, regardless of reasoning backend. See MVP_Design.md §3.1.

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

EMBEDDING_MODEL=nomic-embed-text

# Needed once, for Hindi/Marathi translation (gated model on Hugging Face).
# See backend/app/pipeline/translation.py for the one-time setup steps.
HF_TOKEN=

# --- Supabase ---
# New-style Supabase API keys: PUBLISHABLE_KEY is the anon-key equivalent
# (safe for client use), SECRET_KEY is the service-role equivalent (bypasses
# RLS — server-side only, never sent to the frontend).
PUBLISHABLE_KEY=
SECRET_KEY=
SUPABASE_URL=https://<ref>.supabase.co
# Supavisor transaction-mode pooler URL (port 6543) — required, not the
# direct :5432 connection. Used in every environment, dev included, so there
# is no separate local database to run.
DATABASE_URL=postgresql+psycopg2://postgres.<ref>:<url-encoded-pw>@<host>.pooler.supabase.com:6543/postgres

OLLAMA_HOST=http://localhost:11434
OLLAMA_NUM_THREAD=4

# --- reCAPTCHA Enterprise (abuse protection on signup/login, citizen + leader) ---
# Created via `gcloud recaptcha keys create` / `gcloud services api-keys create`
# (free tier: 10k assessments/month). RECAPTCHA_SITE_KEY is public (also used
# by the frontend build, VITE_RECAPTCHA_SITE_KEY). RECAPTCHA_API_KEY is
# server-side only, restricted to the recaptchaenterprise API. If left empty,
# verification is skipped (logs a warning) rather than blocking local dev/CI.
RECAPTCHA_SITE_KEY=
RECAPTCHA_API_KEY=
RECAPTCHA_PROJECT_ID=civic-voice-agent
RECAPTCHA_MIN_SCORE=0.5
