# --- LLM backend switch ---
# GROQ_API_KEY set  -> Groq does reasoning (GROQ_MODEL), Ollama does embeddings only.
# GROQ_API_KEY empty/commented -> Ollama does everything (OLLAMA_LLM_MODEL + embeddings).
# Both model names can stay set at once — only GROQ_API_KEY needs to change.

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
OLLAMA_LLM_MODEL=qwen2.5:1.5b

EMBEDDING_MODEL=nomic-embed-text

# Needed once, for Hindi/Marathi translation (gated model on Hugging Face).
# See backend/app/pipeline/translation.py for the one-time setup steps.
HF_TOKEN=

DB_PATH=civic.db
OLLAMA_HOST=http://localhost:11434
OLLAMA_NUM_THREAD=4
