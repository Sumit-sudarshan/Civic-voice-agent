[Unit]
Description=Civic Voice Agent FastAPI backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sumit
WorkingDirectory=/home/sumit/civic-voice-agent/backend
ExecStartPre=/bin/bash /home/sumit/civic-voice-agent/deploy/fetch_secrets.sh
ExecStart=/home/sumit/civic-voice-agent/backend/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --app-dir /home/sumit/civic-voice-agent/backend
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
